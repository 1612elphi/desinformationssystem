[Unit]
Description=Desinformationssystem bounded nightly PDF backfill
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=BACKFILL_MAX_SECONDS=14400
ExecStart=/home/ruby/desinformationssystem/ops/pdf-backfill.sh
# Budget is 4h; allow a margin for the final in-flight fetch.
TimeoutStartSec=18000
StandardOutput=journal
StandardError=journal
