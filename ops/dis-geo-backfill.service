[Unit]
Description=Desinformationssystem geo tagging (streets + Stadtteil) + data-quality report
After=network-online.target

[Service]
Type=oneshot
# ruby, not root: host Python reads the ruby-owned DB and keeps its -wal/-shm
# files ruby-owned for the uid-1000 containers (same as enrich-claude).
User=ruby
Group=ruby
# switchboard proxies TypeSafe and holds the key; no secret here. Override to
# http://switchboard:3000/typesafe if this ever runs inside the compose network.
Environment=TYPESAFE_BASE_URL=http://localhost:3990/typesafe
ExecStart=/home/ruby/desinformationssystem/ops/geo-backfill.sh
TimeoutStartSec=14400
StandardOutput=journal
StandardError=journal
