# Copy to .env and fill in. The .env file is git-ignored / not committed.

# --- LLM enrichment (OpenRouter / DeepSeek V4 Pro) ---
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-pro
ENABLE_LLM=1
# Parallel enrichment workers (DeepSeek V4 Pro ~20s/call; raise for big backfills).
ENRICH_CONCURRENCY=4
# Vote-tally image parser (live ticker + image-only Abstimmungsergebnis PDFs)
ENABLE_VOTE_PARSE=1
VISION_MODEL=google/gemini-3.1-flash-lite
# Live-ticker watcher poll cadence (seconds): fast while live, slow when idle
TICKER_POLL=120
TICKER_IDLE_POLL=900
# OPENROUTER_BASE=https://openrouter.ai/api/v1
# ENRICH_MAXCHARS=24000
# LLM_MIN_INTERVAL=1.0

# --- Ingestion engine ---
# html  = scraper.py (HTML scraping, the proven default)
# oparl = oparl.py (OParl API ingester; incremental via modified_since watermark
#         in meta 'oparl_since'; see docs/oparl-migration.md before flipping)
INGEST=html
# OParl endpoint, used only when INGEST=oparl. Note the /ris prefix: the API's
# own self-links omit it and 404, so oparl.py rewrites them. Overridable in case
# the vendor moves the path again.
# OPARL_BASE=https://web1.karlsruhe.de/ris/oparl
# OPARL_BODY=0001

# --- Scrape window & politeness ---
BACKFILL_MONTHS=12
# Re-crawl meetings held in the last N days each run, to pull late-added voting
# results / minutes and detect in-place document updates (cheap HEAD compare).
RECHECK_DAYS=21
REQUEST_INTERVAL=1.5
MAX_RETRIES=5
USER_AGENT=DesinfoBot/1.0 (+personal Karlsruhe Sitzungskalender archive; contact rmv@rmv.fyi)

# --- Daily schedule (container local time) ---
SCRAPE_HOUR=3
SCRAPE_MINUTE=30
TZ=Europe/Berlin

# --- Optional ---
# OCR for scanned PDFs (also add tesseract/ocrmypdf to the Dockerfile to use):
ENABLE_OCR=0
# Give up on an unreadable vote-tally scan after this many vision-model attempts:
VOTE_PARSE_MAX_ATTEMPTS=3
# Cloudflare fallback (only used on a 403). Leave EMPTY unless you actually run
# a FlareSolverr instance the containers can reach (the hostname below only
# resolves on this host's "mediastack" docker network):
FLARESOLVERR_URL=
